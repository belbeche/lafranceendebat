{% extends 'base.html.twig' %}
{% block title %}{{ i.name }} | Ils ont contribué | La France en Débat{% endblock %}
{% block body %}
<header class="page-head"><div class="container">
    <p class="meta mb-1"><a href="{{ path('app_inspirations') }}">&larr; Ils ont contribué, ils ont innové</a></p>
    <h1>{{ i.name }}</h1>
    <p class="lead mb-0">{{ i.domainLabel }}</p>
</div></header>
<section class="section"><div class="container" style="max-width:820px">
    <h2 class="h4">Ce que cette personne a apporté</h2>
    <p class="measure">{{ i.summary|e|nl2br }}</p>
    {% if i.advances %}
    <h2 class="h4 mt-4">Les avancées</h2>
    <ul class="list-group list-group-flush mb-3">
        {% for a in i.advances %}<li class="list-group-item px-0"><i class="bi bi-check2-circle text-success me-2" aria-hidden="true"></i>{{ a }}</li>{% endfor %}
    </ul>
    {% endif %}
    <p class="meta">Source publique : <a href="{{ i.sourceUrl }}" target="_blank" rel="noopener noreferrer nofollow">{{ i.sourceHost }}</a>. Fiche relue par la modération le {{ i.createdAt|date('d/m/Y') }}.</p>
    {% if same %}
    <h2 class="h5 mt-5">Dans le même domaine</h2>
    <ul>{% for o in same %}<li><a href="{{ path('app_inspiration_show', {id: o.id}) }}">{{ o.name }}</a></li>{% endfor %}</ul>
    {% endif %}
    <p class="mt-4"><a class="btn btn-bleu" href="{{ path('app_inspirations') }}#proposer">Proposer une autre personne</a></p>
</div></section>
{% endblock %}
