{% set detected = app.request.attributes.get('_lang_detected', 'fr') %}
<div class="lang-overlay" role="dialog" aria-modal="true" aria-labelledby="lang-title">
    <div class="lang-box">
        <p class="lang-brand serif">La France en <span>Débat</span></p>
        <h2 id="lang-title" class="h3">{{ 'lang.title'|trans }}</h2>
        <p class="text-muted">{{ 'lang.subtitle'|trans }}</p>
        <a class="btn btn-bleu btn-lg w-100 mb-3" href="{{ path('app_language', {code: detected, next: current_path()}) }}" lang="{{ detected }}">
            <span translate="no">{{ 'lang.continue'|trans({'%language%': lang_name(detected)}, null, detected) }}</span>
        </a>
        <div class="lang-grid" translate="no">
            {% for code, l in languages() %}{% if l.ui %}
                <a href="{{ path('app_language', {code: code, next: current_path()}) }}" lang="{{ code }}" hreflang="{{ code }}" class="lang-chip {{ code == detected ? 'on' }}">{{ l.name }}</a>
            {% endif %}{% endfor %}
        </div>
        <details class="mt-3">
            <summary>{{ lang_has_ui('en') ? 'Other languages / Autres langues' }}</summary>
            <p class="small text-muted mt-2">{{ 'lang.other_note'|trans({}, null, 'en') }}</p>
            <div class="lang-grid" translate="no">
                {% for code, l in languages() %}{% if not l.ui %}
                    <a href="{{ path('app_language', {code: code, next: current_path()}) }}" lang="{{ code }}" hreflang="{{ code }}" class="lang-chip">{{ l.name }}</a>
                {% endif %}{% endfor %}
            </div>
        </details>
    </div>
</div>
