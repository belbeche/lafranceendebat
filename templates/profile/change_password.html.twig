{% extends 'base.html.twig' %}
{% block title %}Changer de mot de passe{% endblock %}
{% block body %}
<header class="page-head"><div class="container"><h1>Changer de mot de passe</h1></div></header>
<section class="section"><div class="container"><div class="row"><div class="col-lg-5"><div class="form-card">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
        <div class="mb-3"><label class="form-label" for="cp">Mot de passe actuel</label><input class="form-control" id="cp" type="password" name="current_password" autocomplete="current-password" required></div>
        <div class="mb-3"><label class="form-label" for="np">Nouveau mot de passe</label><input class="form-control" id="np" type="password" name="new_password" autocomplete="new-password" minlength="10" required><div class="form-text">10 caractères au minimum.</div></div>
        <div class="mb-3"><label class="form-label" for="cf">Confirmer le nouveau mot de passe</label><input class="form-control" id="cf" type="password" name="confirm_password" autocomplete="new-password" required></div>
        <button class="btn btn-bleu" type="submit">Changer</button> <a class="btn btn-link" href="{{ path('app_profile') }}">Annuler</a>
    </form>
</div></div></div></div></section>
{% endblock %}
