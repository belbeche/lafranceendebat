{# Messages flash : texte échappé, aucun HTML accepté. #}
{% set flashes = app.flashes %}
{% if flashes|length %}
<div class="container mt-3" aria-live="polite">
    {% for type, messages in flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="{{ type in ['danger', 'error', 'warning'] ? 'alert' : 'status' }}">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}
