{# templates/debug/stripe_prices.html.twig #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
    <h1>Debug Stripe Prices</h1>
    
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Price ID</th>
                <th>Valid</th>
            </tr>
        </thead>
        <tbody>
            {% for result in results %}
            <tr>
                <td>{{ result.type }}</td>
                <td><code>{{ result.price_id }}</code></td>
                <td>
                    {% if result.valid %}
                        <span class="badge bg-success">VALID</span>
                    {% else %}
                        <span class="badge bg-danger">INVALID</span>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="3">No Stripe prices configured</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}