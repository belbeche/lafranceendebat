<script type="application/ld+json" nonce="{{ csp_nonce() }}">{{ {'@context': 'https://schema.org', '@type': 'Article', 'headline': title|striptags|slice(0, 110), 'description': intro|striptags|slice(0, 250), 'url': url(app.request.attributes.get('_route') ?: 'app_home', app.request.attributes.get('_route_params') ?: {}), 'inLanguage': app.request.locale, 'author': {'@type': 'Organization', 'name': site_name}, 'publisher': {'@type': 'Organization', 'name': site_name, 'url': url('app_home')}, 'isAccessibleForFree': true}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
<header class="page-head"><div class="container" style="max-width:860px"><p class="meta mb-1"><a class="text-white" href="{{ path('app_dossiers') }}">Dossiers</a></p><h1>{{ title }}</h1><p class="lead mb-0">{{ intro }}</p></div></header>
