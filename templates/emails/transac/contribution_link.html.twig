{% extends 'emails/transac/_layout.html.twig' %}
{% block title %}Votre lien de contribution{% endblock %}
{% block content %}
<h1 style="font-size:20px;color:#00164f">Votre lien de contribution</h1>
<p>Bonjour {{ name }}, voici le lien personnel pour retrouver la page de votre contribution.</p>
<p><a href="{{ link }}" style="background:#002395;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none;display:inline-block">Retrouver ma contribution</a></p>
<p style="font-size:13px;color:#555">Ce lien est personnel : ne le partagez pas. Si le bouton ne marche pas, copiez cette adresse : {{ link }}</p>
{% endblock %}
