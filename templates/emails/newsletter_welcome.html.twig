            padding: 16px 35px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            margin: 25px 0;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
            border: 2px solid #ff9900;
        }
        .cta-button:hover {
