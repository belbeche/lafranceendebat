{% extends 'base.html.twig' %}
{% block title %}Se connecter{% endblock %}
{% block body %}
<section class="section"><div class="container"><div class="row justify-content-center"><div class="col-md-7 col-lg-5">
    <h1 class="h2">Se connecter</h1>
    <div class="form-card mt-3">
        {% if error %}
            {% set cls = error_class|default('') %}
            <div class="alert alert-danger" role="alert">
            {% if 'InvalidCsrfToken' in cls %}Votre page de connexion a expiré. Rechargez la page puis réessayez.
            {% elseif 'TooManyLoginAttempts' in cls %}Trop de tentatives. Patientez quelques minutes avant de réessayer, ou <a href="{{ path('app_forgot_password_request') }}">réinitialisez votre mot de passe</a>.
            {% elseif 'CustomUserMessage' in cls %}{{ error.messageKey }}
            {% else %}Adresse email ou mot de passe incorrect.{% endif %}
            </div>
        {% endif %}
        <form method="post">
            <div class="mb-3"><label class="form-label" for="username">Adresse email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control" autocomplete="email" required autofocus></div>
            <div class="mb-3"><label class="form-label" for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" data-toggle-password="1" class="form-control" autocomplete="current-password" required></div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="remember" name="_remember_me" checked><label class="form-check-label" for="remember">Rester connecté sur cet appareil</label></div>
            <button class="btn btn-bleu w-100" type="submit">Se connecter</button>
        </form>
        <p class="mt-3 mb-1"><a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a></p>
        <p class="mb-0">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
    </div>
</div></div></div></section>
{% endblock %}
