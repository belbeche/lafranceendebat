{# templates/post/_post_grid.html.twig #}
{% if posts is defined and posts|length > 0 %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for post in posts %}
            <div class="col">
                {% include 'post/_post_card.html.twig' with {'post': post} %}
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if pagination is defined and pagination %}
        <div class="mt-5">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    {% if pagination.currentPage > 1 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': pagination.currentPage - 1})) }}" aria-label="Précédent">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">&laquo;</span>
                        </li>
                    {% endif %}

                    {% for page in 1..pagination.pageCount %}
                        {% if page == pagination.currentPage %}
                            <li class="page-item active">
                                <span class="page-link">{{ page }}</span>
                            </li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': page})) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.currentPage < pagination.pageCount %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': pagination.currentPage + 1})) }}" aria-label="Suivant">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">&raquo;</span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        </div>
    {% endif %}

    <!-- Message si pas de résultats -->
{% else %}
    <div class="text-center py-5">
        <div class="mb-4">
            <i class="fas fa-newspaper fa-4x text-muted"></i>
        </div>
        <h4 class="fw-bold text-dark mb-3">Aucun article trouvé</h4>
        <p class="text-muted mb-4">Il n'y a pas encore d'articles publiés.</p>
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_AUTHOR') %}
            <a href="{{ path('app_post_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Créer votre premier article
            </a>
        {% endif %}
    </div>
{% endif %}