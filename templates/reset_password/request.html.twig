{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié | La France en Débat{% endblock %}
{% block body %}
<section class="section"><div class="container"><div class="row justify-content-center"><div class="col-md-7 col-lg-5">
    <h1 class="h2">Mot de passe oublié</h1>
    <p class="text-muted">Indiquez l'adresse email de votre compte. Nous vous envoyons un lien valable 1 heure pour choisir un nouveau mot de passe.</p>
    {% for m in app.flashes('warning') %}<div class="alert alert-warning mt-3" role="alert">{{ m }}</div>{% endfor %}
    <div class="form-card mt-3">
        {{ form_start(requestForm, {attr: {novalidate: 'novalidate'}}) }}
            <div class="mb-3">
                {{ form_label(requestForm.email, 'Adresse email', {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(requestForm.email, {attr: {class: 'form-control', autocomplete: 'email', autofocus: 'autofocus', placeholder: 'prenom.nom@exemple.fr'}}) }}
                {{ form_errors(requestForm.email) }}
            </div>
            <button class="btn btn-bleu w-100" type="submit">Recevoir le lien</button>
        {{ form_end(requestForm) }}
        <p class="mt-3 mb-0"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
    </div>
</div></div></div></section>
{% endblock %}
