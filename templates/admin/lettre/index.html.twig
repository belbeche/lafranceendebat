{% extends 'admin/_layout.html.twig' %}
{% block title %}Lettres{% endblock %}
{% block admin %}
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Lettres d'information</h1><a class="btn btn-bleu" href="{{ path('admin_lettre_new') }}">Nouvelle lettre</a></div>
{% if problem %}<div class="alert alert-warning">{{ problem }}</div>{% endif %}
<p>{{ eligible }} abonné(s) ont confirmé leur adresse et peuvent recevoir une lettre. {{ eligibleActors }} acteur(s) public(s) peuvent être invités, {{ consentedActors }} ont accepté. <a href="{{ path('admin_actors') }}">Gérer les acteurs publics</a></p>
<table class="table"><thead><tr><th>Objet</th><th>Statut</th><th>Envoyés</th><th>Échecs</th><th></th></tr></thead><tbody>
{% for l in lettres %}<tr><td>{{ l.subject }}</td><td>{{ l.status }}</td><td>{{ l.sentCount }}{% if l.targetCount %} / {{ l.targetCount }}{% endif %}</td><td>{{ l.failedCount }}</td><td><a href="{{ path('admin_lettre_show', {id: l.id}) }}">Ouvrir</a></td></tr>
{% else %}<tr><td colspan="5" class="text-muted">Aucune lettre pour l'instant.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
