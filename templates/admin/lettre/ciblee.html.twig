{% extends 'admin/_layout.html.twig' %}
{% block title %}Envoi ciblé{% endblock %}
{% block admin %}
<h1 class="h3">Envoi ciblé</h1>
<p class="text-muted">Pour écrire à quelques adresses professionnelles choisies à la main (maximum {{ max }}), par exemple proposer un partenariat. Chaque message indique qui écrit, pourquoi, où l'adresse est publiée, et contient un lien de désinscription en un clic. Un désinscrit n'est jamais recontacté.</p>
{% if problem %}<div class="alert alert-warning">{{ problem }}</div>{% endif %}
{% if result %}<div class="alert alert-success">{{ result.sent }} message(s) envoyé(s).{% if result.failed %} Échec pour : {{ result.failed|join(', ') }}.{% endif %}</div>{% endif %}
<form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('lettre_ciblee') }}">
    <label class="form-label fw-bold" for="recipients">Destinataires (une ligne par adresse)</label>
    <textarea id="recipients" name="recipients" rows="4" class="form-control font-monospace mb-1">{{ recipients }}</textarea>
    <p class="form-text">Format : <code>adresse;organisation;fonction;page publique https où l'adresse est publiée</code>. Les adresses personnelles (gmail, orange…) sont refusées.</p>
    <label class="form-label fw-bold" for="subject">Objet</label>
    <input id="subject" name="subject" class="form-control mb-3" maxlength="160" value="{{ subject }}">
    <label class="form-label fw-bold" for="body">Message (texte brut)</label>
    <textarea id="body" name="body" rows="16" class="form-control mb-3">{{ body }}</textarea>
    {% if rows %}
    <table class="table table-sm"><thead><tr><th>Adresse</th><th>Organisation</th><th>Contrôle</th></tr></thead><tbody>
    {% for r in rows %}<tr><td>{{ r.email }}</td><td>{{ r.organisation }}</td><td>{% if r.problem %}<span class="text-danger">{{ r.problem }}</span>{% else %}<span class="text-success">Prêt</span>{% endif %}</td></tr>{% endfor %}
    </tbody></table>
    {% endif %}
    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirm" id="confirm" value="1"><label class="form-check-label" for="confirm">J'ai relu le message et vérifié que chaque adresse est bien publiée par son organisation.</label></div>
    <button class="btn btn-outline-secondary" name="action" value="check">Contrôler</button>
    <button class="btn btn-outline-primary" name="action" value="test">M'envoyer un test</button>
    <button class="btn btn-primary" name="action" value="send">Envoyer</button>
</form>
{% endblock %}
