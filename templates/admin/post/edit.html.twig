{% extends 'base.html.twig' %}

{% block title %}Modifier la Publication - La France en Débat{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-edit"></i>
                        Modifier la Publication
                    </h4>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
                    
                    <!-- Informations sur la publication -->
                    <div class="alert alert-info">
                        <div class="row">
                            <div class="col-md-6">
                                <strong><i class="fas fa-calendar"></i> Créée le :</strong> 
                                {{ post.createdAt|date('d/m/Y à H:i') }}
                            </div>
                            <div class="col-md-6">
                                <strong><i class="fas fa-user"></i> Auteur :</strong> 
                                {{ post.author.firstName ?? 'Admin' }}
                            </div>
                            {% if post.updatedAt %}
                            <div class="col-md-12 mt-2">
                                <strong><i class="fas fa-sync"></i> Dernière modification :</strong> 
                                {{ post.updatedAt|date('d/m/Y à H:i') }}
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.title, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.title) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.type, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.type) }}
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.content, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                        {{ form_errors(form.content) }}
                    </div>

                    <!-- Fichier média actuel -->
                    {% if post.mediaPath %}
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fas fa-paperclip"></i>
                                Fichier actuel
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    {% if post.isVideo %}
                                        <i class="fas fa-video text-primary fa-2x me-3"></i>
                                    {% elseif post.isImage %}
                                        <i class="fas fa-image text-success fa-2x me-3"></i>
                                    {% elseif post.isDocument %}
                                        <i class="fas fa-file-pdf text-danger fa-2x me-3"></i>
                                    {% endif %}
                                    <strong>{{ post.mediaPath }}</strong>
                                    <br>
                                    <small class="text-muted">Type: {{ post.mediaType }}</small>
                                </div>
                                <div>
                                    <a href="{{ asset(post.mediaUrl) }}" 
                                       class="btn btn-outline-primary btn-sm" 
                                       target="_blank">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ asset(post.mediaUrl) }}" 
                                       class="btn btn-outline-success btn-sm" 
                                       download>
                                        <i class="fas fa-download"></i> Télécharger
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    <div class="mb-4">
                        {{ form_label(form.mediaFile, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.mediaFile, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-text">
                            Laissez vide pour conserver le fichier actuel, ou uploader un nouveau fichier pour le remplacer.
                        </div>
                        {{ form_errors(form.mediaFile) }}
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isPublished, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.isPublished, null, {'label_attr': {'class': 'form-check-label fw-bold'}}) }}
                        </div>
                    </div>

                    <!-- Statistiques de la publication -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="fas fa-chart-bar"></i>
                                Statistiques de la publication
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <div class="border rounded p-3">
                                        <h4 class="text-primary">{{ post.comments|length }}</h4>
                                        <p class="small mb-0">Commentaires</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded p-3">
                                        <h4 class="text-success">
                                            {% if post.isPublished %}Actif{% else %}Masqué{% endif %}
                                        </h4>
                                        <p class="small mb-0">Statut</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="border rounded p-3">
                                        <h4 class="text-info">{{ post.type|upper }}</h4>
                                        <p class="small mb-0">Type</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ path('admin_posts_index') }}" class="btn btn-secondary me-md-2">
                            <i class="fas fa-arrow-left"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-warning me-md-2">
                            <i class="fas fa-save"></i> Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_actualites') }}" class="btn btn-primary" target="_blank">
                            <i class="fas fa-eye"></i> Voir sur le site
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.alert-info {
    background-color: #d1ecf1;
    border-color: #bee5eb;
    color: #0c5460;
}

.card {
    border: none;
    border-radius: 10px;
}

.btn-warning {
    background-color: #ffc107;
    border-color: #ffc107;
    color: #212529;
}

.btn-warning:hover {
    background-color: #e0a800;
    border-color: #d39e00;
}
</style>
{% endblock %}