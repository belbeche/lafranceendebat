{# templates/admin/visitors/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Statistiques des visiteurs - Admin{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Statistiques des visiteurs</h1>
                <div>
                    <a href="{{ path('admin_visitors_export') }}" class="btn btn-success">
                        <i class="fas fa-download me-2"></i>Exporter CSV
                    </a>
                    <a href="{{ path('admin_visitors_cleanup') }}" class="btn btn-warning" 
                       onclick="return confirm('Supprimer les visites de plus de 90 jours ?')">
                        <i class="fas fa-trash me-2"></i>Nettoyer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-primary shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-primary">{{ stats.today }}</div>
                        <div class="text-xs text-muted">Aujourd'hui</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-success shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-success">{{ stats.yesterday }}</div>
                        <div class="text-xs text-muted">Hier</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-info shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-info">{{ stats.last_week }}</div>
                        <div class="text-xs text-muted">7 derniers jours</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-warning shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-warning">{{ stats.last_month }}</div>
                        <div class="text-xs text-muted">30 derniers jours</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-danger shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-danger">{{ stats.total }}</div>
                        <div class="text-xs text-muted">Total unique</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card border-left-secondary shadow h-100">
                <div class="card-body">
                    <div class="text-center">
                        <div class="h5 font-weight-bold text-secondary">{{ visitors|length }}</div>
                        <div class="text-xs text-muted">Dernières visites</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Liste des visiteurs récents -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">100 dernières visites</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Date/Heure</th>
                                    <th>IP</th>
                                    <th>Localisation</th>
                                    <th>Page</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for visitor in visitors %}
                                <tr>
                                    <td>
                                        <small>
                                            {{ visitor.visitedAt|date('d/m/Y') }}<br>
                                            <span class="text-muted">{{ visitor.visitedAt|date('H:i:s') }}</span>
                                        </small>
                                    </td>
                                    <td>
                                        <code>{{ visitor.ipAddress }}</code>
                                    </td>
                                    <td>
                                        {% if visitor.countryCode %}
                                            <span class="fi fi-{{ visitor.countryCode|lower }} me-1"></span>
                                            {{ visitor.countryCode }}
                                            {% if visitor.city and visitor.city != 'Unknown' and visitor.city != 'Local' %}
                                                <br><small class="text-muted">{{ visitor.city }}</small>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Inconnu</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <small class="text-truncate d-inline-block" style="max-width: 200px;" 
                                               title="{{ visitor.pageVisited ?? 'N/A' }}">
                                            {{ visitor.pageVisited ?? 'N/A' }}
                                        </small>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="fas fa-users fa-2x mb-3"></i>
                                        <p>Aucune visite enregistrée</p>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques détaillées -->
        <div class="col-xl-4 col-lg-5">
            <!-- Pages populaires -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Pages populaires</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless" width="100%">
                            <tbody>
                                {% for page in popular_pages %}
                                <tr>
                                    <td>
                                        <small class="text-truncate d-inline-block" style="max-width: 180px;" 
                                               title="{{ page.page }}">
                                            {{ page.page }}
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-primary rounded-pill">{{ page.visits }}</span>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="2" class="text-center text-muted">Aucune donnée</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Visiteurs par pays -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Visiteurs par pays</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless" width="100%">
                            <tbody>
                                {% for country in visitors_by_country %}
                                <tr>
                                    <td>
                                        {% if country.country %}
                                            <span class="fi fi-{{ country.country|lower }} me-1"></span>
                                            {{ country.country }}
                                        {% else %}
                                            <span class="text-muted">Inconnu</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-success rounded-pill">{{ country.visitors }}</span>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="2" class="text-center text-muted">Aucune donnée</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.fi {
    border-radius: 3px;
    box-shadow: 0 0 1px rgba(0,0,0,0.5);
}
.card {
    border: none;
    border-radius: 0.5rem;
}
.table th {
    border-top: none;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #6c757d;
}
</style>
{% endblock %}