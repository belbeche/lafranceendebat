{% extends 'admin/_layout.html.twig' %}
{% block title %}Comptes{% endblock %}
{% block admin %}
<h1 class="h3">Comptes</h1>
<div class="table-responsive"><table class="table table-sm align-middle bg-white admin-table">
    <thead><tr><th>Nom</th><th>Email</th><th>Rôles</th><th>État</th><th>Dernière connexion</th><th></th></tr></thead>
    <tbody>
    {% for u in users %}
        <tr><td>{{ u.fullName }}</td><td>{{ u.email }}</td><td>{{ u.roles|join(', ') }}</td><td>{{ u.enabled ? 'actif' : 'suspendu' }}</td><td>{% if u.lastLogin %}{{ u.lastLogin|date('d/m/Y H:i') }} <a href="{{ path('admin_user_logins', {id: u.id}) }}">historique</a>{% else %}<span class="text-muted">jamais enregistrée</span>{% endif %}</td>
        <td class="text-end text-nowrap">
            <form method="post" action="{{ path('admin_moderation_reset_link') }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('admin_reset_link') }}"><input type="hidden" name="email" value="{{ u.email }}"><button class="btn btn-sm btn-outline-dark">Lien mot de passe</button></form>
            {% if u != app.user %}
            <form method="post" action="{{ path('admin_user_toggle', {id: u.id}) }}" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('toggleuser' ~ u.id) }}"><button class="btn btn-sm btn-outline-dark">{{ u.enabled ? 'Suspendre' : 'Réactiver' }}</button></form>
            <form method="post" action="{{ path('admin_user_delete', {id: u.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce compte ?');"><input type="hidden" name="_token" value="{{ csrf_token('deleteuser' ~ u.id) }}"><button class="btn btn-sm btn-outline-danger">Supprimer</button></form>
            {% endif %}
        </td></tr>
    {% endfor %}
    </tbody>
</table></div>
{% endblock %}
