{% extends 'base.html.twig' %}
{% block title %}Annonces de mission | La France en Débat{% endblock %}
{% block body %}
<header class="page-head"><div class="container">
    <h1>Annonces : demander ou proposer de l'aide</h1>
    <p class="lead mb-2">Vous avez un besoin concret, ou un savoir-faire à offrir ? Publiez une annonce. La modération la relit, puis les autres membres peuvent vous répondre sans que vos coordonnées soient publiques.</p>
    <a class="btn btn-rouge" href="{{ path('app_mission_post_new', {type: 'demande'}) }}">J'ai besoin d'aide</a>
    <a class="btn btn-bleu" href="{{ path('app_mission_post_new', {type: 'offre'}) }}">Je propose mon aide</a>
    <a class="btn btn-outline-light" href="{{ path('app_missions') }}">Missions de la plateforme</a>
</div></header>
<section class="section"><div class="container">
    <p>
        <a class="btn btn-sm {{ kind is null ? 'btn-dark' : 'btn-outline-dark' }}" href="{{ path('app_mission_posts') }}">Toutes</a>
        <a class="btn btn-sm {{ kind == 'demande' ? 'btn-dark' : 'btn-outline-dark' }}" href="{{ path('app_mission_posts', {type: 'demande'}) }}">Besoins d'aide</a>
        <a class="btn btn-sm {{ kind == 'offre' ? 'btn-dark' : 'btn-outline-dark' }}" href="{{ path('app_mission_posts', {type: 'offre'}) }}">Aides proposées</a>
    </p>
    <div class="row g-3">
    {% for p in posts %}
        <div class="col-md-6"><div class="carte h-100">
            <p class="mb-1"><span class="etiquette {{ p.demande ? 'rouge' : 'bleu' }}">{{ p.kindLabel }}</span> <span class="etiquette">{{ p.payLabel }}</span>{% if p.territory %} <span class="meta">{{ p.territory }}</span>{% endif %}</p>
            <h2 class="h5">{{ p.title }}</h2>
            <p>{{ p.description|e|nl2br }}</p>
            <p class="meta">Par {{ p.author.publicName }}, le {{ p.createdAt|date('d/m/Y') }}</p>
            {% if app.user and app.user is same as p.author %}
                <form method="post" action="{{ path('app_mission_post_close', {id: p.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('mission_close' ~ p.id) }}"><button class="btn btn-sm btn-outline-dark">Clôturer mon annonce</button></form>
            {% else %}
                <a class="btn btn-sm btn-bleu" href="{{ path('app_mission_post_reply', {id: p.id}) }}">{{ p.demande ? 'Je peux aider' : 'Je souhaite cette aide' }}</a>
            {% endif %}
        </div></div>
    {% else %}
        <div class="col-12"><p class="meta">Aucune annonce publiée pour l'instant. Lancez la première.</p></div>
    {% endfor %}
    </div>
    {% if mine %}
    <h2 class="h5 mt-5">Mes annonces</h2>
    {% for p in mine %}<div class="rangee">{{ p.title }} <span class="meta">({{ p.kindLabel }}) :
        {% if p.status == 'pending' %}en attente de relecture{% elseif p.status == 'published' %}publiée{% elseif p.status == 'rejected' %}refusée{% if p.moderationNote %} : {{ p.moderationNote }}{% endif %}{% else %}clôturée{% endif %}</span></div>{% endfor %}
    {% endif %}
</div></section>
{% endblock %}
