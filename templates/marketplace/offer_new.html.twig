{% extends 'base.html.twig' %}
{% block title %}Nouvelle prestation{% endblock %}
{% block body %}
<header class="page-head"><div class="container"><h1>Proposer une prestation</h1></div></header>
<section class="section"><div class="container" style="max-width: 720px">
{% for e in errors %}<div class="alert alert-danger">{{ e }}</div>{% endfor %}
<form method="post" class="carte p-3">
    <input type="hidden" name="_token" value="{{ csrf_token('offer_new') }}">
    <label class="form-label" for="title">Titre</label><input class="form-control mb-3" id="title" name="title" value="{{ data.title }}" maxlength="120" required>
    <label class="form-label" for="category">Catégorie</label><select class="form-select mb-3" id="category" name="category">{% for k, l in categories %}<option value="{{ k }}" {{ data.category == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select>
    <label class="form-label" for="description">Description (contenu, durée, livrable)</label><textarea class="form-control mb-3" id="description" name="description" rows="8" maxlength="4000" required>{{ data.description }}</textarea>
    <label class="form-label" for="price">Prix payé par le client, en euros</label><input class="form-control mb-1" id="price" name="price" inputmode="decimal" value="{{ data.price }}" required>
    <p class="meta">Vous recevrez ce prix moins {{ (bps / 100)|number_format(1, ',', ' ') }} % de contribution.</p>
    <label class="form-label" for="area">Zone (facultatif)</label><input class="form-control mb-3" id="area" name="area" value="{{ data.area }}" maxlength="120">
    <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="no_political" name="no_political" value="1" required><label class="form-check-label" for="no_political">Je confirme que cette prestation n'est destinée ni à un parti, ni à un candidat, ni à une campagne électorale, et qu'elle est proposée à son prix réel (pas gratuite ni symbolique). <a href="{{ path('app_marketplace_terms') }}">Voir les conditions</a></label></div>
    <button class="btn btn-primary">Envoyer pour relecture</button>
</form>
</div></section>
{% endblock %}
