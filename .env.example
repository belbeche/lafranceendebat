###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=CHANGEZ_MOI_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Adapter à votre base (MySQL/MariaDB ou PostgreSQL). Exemple SQLite pour un essai local :
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

APP_URL=http://localhost:8000
PUBLISHER_NAME="La France en Débat"
PUBLISHER_ADDRESS=""
PUBLISHER_SIRET=""
PUBLISHER_CONTACT=""
PUBLISHER_TRADE=""
PUBLISHER_PHONE=""
PUBLISHER_DIRECTOR=""
# Statut de l editeur : micro-entreprise (pas de recu fiscal). Garder a 0.
DONATION_RECEIPTS_ENABLED=0
# Ouvre la page /soutenir (contributions de soutien, sans reçu fiscal). Mettre 1 seulement avec Stripe configuré.
DONATIONS_OPEN=0

###> Lettre d'information (envoi en masse securise) ###
# Adresse d'expedition (domaine avec SPF, DKIM et DMARC configures). Obligatoire pour envoyer.
MAIL_FROM=
# Agenda : flux ICS officiels supplémentaires (URL https séparées par des virgules, hôtes autorisés uniquement)
AGENDA_ICS_FEEDS=
MAIL_FROM_NAME="La France en Débat"
###< Lettre ###

###> Avis d'IA facultatif (Google AI Studio) ###
# Clé à créer sur https://aistudio.google.com/apikey ; laisser vide pour désactiver l'avis d'IA.
# Mettre la vraie clé dans .env.local, jamais ici.
# Facultatif : deuxième avis de modération et score de fiabilité (envoie le texte à Google, voir la politique de confidentialité)
# GEMINI_API_KEY=
